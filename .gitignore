!/README.md
!/CP2K_PIPELINE.md
!/cp2k_pipeline.md
!/SECOND_BRAIN.md
!/SECOND_BRAIN_COARACI.md
!/0[0-9]_*.py
!/core/
!/parsers/
!/jobs/
!/scripts/
!/legacy/
__pycache__/
*.pyc
/legacy/scripts/.bak_*/
